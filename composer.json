{
    "name": "yavuz/filament-theme",
    "description": "A panel theme for Filament: dark full-height sidebar, a top bar with breadcrumbs, search, quick create, pending work and user menu, and calmer tables, badges, cards and empty states.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filament-theme",
        "admin-panel"
    ],
    "homepage": "https://github.com/yavuz/filament-theme",
    "support": {
        "issues": "https://github.com/yavuz/filament-theme/issues",
        "source": "https://github.com/yavuz/filament-theme"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yavuz",
            "homepage": "https://github.com/yavuz"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Yavuz\\FilamentTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yavuz\\FilamentTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yavuz\\FilamentTheme\\FilamentThemeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
